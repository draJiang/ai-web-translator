{
  "manifest_version": 3,
  "name": "AI Web Reader",
  "version": "0.1.0",
  "description": "Use your own configured AI model (OpenAI, Anthropic Claude, Ollama Cloud/local, or any OpenAI-compatible API) to rewrite webpage text in place for easier reading, without changing the page layout. Restore the original at any time.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": ["storage", "scripting", "activeTab", "contextMenus"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://ollama.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
